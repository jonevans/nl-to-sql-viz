NODE_ENV=development
PORT=3001

# Database Configuration - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hardware_store_db
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DATABASE_URL=postgresql://postgres:your-secure-password-here@localhost:5432/hardware_store_db

# MongoDB (legacy - if still needed)
DB_TYPE=mongodb
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_NAME=nlsql_db
MONGODB_USERNAME=admin
MONGODB_PASSWORD=your-mongo-password-here
MONGODB_URI=mongodb://admin:your-mongo-password-here@localhost:27017/nlsql_db

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# LLM Service (deprecated - now integrated)
LLM_SERVICE_URL=http://localhost:3002
LLM_API_KEY=your-api-key-here

# Security & Authentication
JWT_SECRET=your-jwt-secret-here-minimum-32-characters-change-this
JWT_EXPIRES_IN=24h
AUTH_ENABLED=true
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info