# POC User Credentials - EXAMPLE FILE
# Copy this to .env.poc-users and fill in real credentials
# .env.poc-users is gitignored and will NOT be committed

# Admin Users (role: admin)
ADMIN_USER_1_EMAIL=admin1@example.com
ADMIN_USER_1_PASSWORD=SecurePassword123!
ADMIN_USER_1_NAME=Admin User 1

ADMIN_USER_2_EMAIL=admin2@example.com
ADMIN_USER_2_PASSWORD=SecurePassword456!
ADMIN_USER_2_NAME=Admin User 2

# Regular Users (role: user)
USER_1_EMAIL=user1@example.com
USER_1_PASSWORD=UserPassword1!
USER_1_NAME=User One

USER_2_EMAIL=user2@example.com
USER_2_PASSWORD=UserPassword2!
USER_2_NAME=User Two

USER_3_EMAIL=user3@example.com
USER_3_PASSWORD=UserPassword3!
USER_3_NAME=User Three

USER_4_EMAIL=user4@example.com
USER_4_PASSWORD=UserPassword4!
USER_4_NAME=User Four

USER_5_EMAIL=user5@example.com
USER_5_PASSWORD=UserPassword5!
USER_5_NAME=User Five

USER_6_EMAIL=user6@example.com
USER_6_PASSWORD=UserPassword6!
USER_6_NAME=User Six

USER_7_EMAIL=user7@example.com
USER_7_PASSWORD=UserPassword7!
